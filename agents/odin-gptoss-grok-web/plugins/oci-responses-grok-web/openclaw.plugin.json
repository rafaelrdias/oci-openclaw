{
  "id": "oci-responses-grok-web",
  "name": "OCI Responses Grok",
  "version": "0.1.7",
  "description": "OCI Generative AI Responses provider for Grok 4.1 Fast Reasoning. Web search is provided by the selected OpenClaw web_search provider, such as DuckDuckGo.",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true
  },
  "providers": [
    "oci-responses-grok-web"
  ],
  "providerEndpoints": [
    {
      "endpointClass": "openai-compatible",
      "hostSuffixes": [
        "oci.oraclecloud.com"
      ]
    }
  ],
  "providerAuthEnvVars": {
    "oci-responses-grok-web": [
      "OCI_RESPONSES_API_KEY",
      "OPENAI_API_KEY"
    ]
  },
  "setup": {
    "providers": [
      {
        "id": "oci-responses-grok-web",
        "authMethods": [
          "api-key"
        ],
        "envVars": [
          "OCI_RESPONSES_API_KEY",
          "OPENAI_API_KEY"
        ]
      }
    ]
  },
  "contracts": {},
  "uiHints": {},
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
